/* Медиа-запросы для адаптивной верстки */
@media screen and (max-width: 1024px) {
    .nav-link {
        position: static !important;
        font-size: 1.1rem;
        padding: 10px 15px;
        left: auto !important;
        top: auto !important;
        min-width: auto;
        flex: 1;
        text-align: center;
        z-index: 200 !important;
        /* Уменьшаем эффекты свечения для мобильной версии */
        text-shadow: 
            -1px -1px 0 #000,
            1px -1px 0 #000,
            -1px 1px 0 #000,
            1px 1px 0 #000,
            0 0 8px rgba(255, 255, 255, 0.6);
        box-shadow: 
            inset 0 0 15px rgba(255, 255, 255, 0.4),
            0 0 15px rgba(255, 255, 255, 0.4);
    }

    .nav-links {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 30px; /* Увеличиваем расстояние между кнопками */
        width: 95%;
        max-width: 800px;
        justify-content: center;
        flex-wrap: nowrap;
        z-index: 100;
    }

    /* Уменьшаем эффект свечения при наведении */
    .nav-link:hover {
        text-shadow: 
            -1px -1px 0 #000,
            1px -1px 0 #000,
            -1px 1px 0 #000,
            1px 1px 0 #000,
            0 0 10px rgba(255, 255, 255, 0.7);
        box-shadow: 
            inset 0 0 20px rgba(255, 255, 255, 0.5),
            0 0 20px rgba(255, 255, 255, 0.5);
    }

    /* Уменьшаем свечение подложки */
    .nav-link::before {
        background: radial-gradient(
            circle at center,
            rgba(255, 255, 255, 0.2) 0%,
            rgba(255, 255, 255, 0.15) 30%,
            rgba(255, 255, 255, 0.1) 60%,
            transparent 100%
        );
    }

    /* Переопределяем позиционирование для всех кнопок */
    .nav-link:nth-child(1),
    .nav-link:nth-child(2),
    .nav-link:nth-child(3),
    .nav-link:nth-child(4) {
        position: static !important;
        left: auto !important;
        top: auto !important;
        z-index: 200 !important;
    }

    .content {
        padding-top: 100px;
    }

    .hero-content {
        padding: 0 20px;
    }

    .glitch-text {
        font-size: 2rem;
    }

    .artists-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        padding: 20px;
    }

    .artist-card {
        height: auto;
    }

    .artist-info {
        padding: 15px;
    }

    .artist-name {
        font-size: 1.2rem;
    }

    /* Исправлено: фильтр битов тянется на всю ширину, липкий под навигацией */
    .work-filter {
        position: sticky;
        top: 120px;
        left: 0;
        transform: none;
        width: 100%;
        max-width: 100%;
        padding: 0 4%;
        background: rgba(0,0,0,0.95);
        z-index: 1500; /* Выше навигации но ниже nav-links */
        visibility: visible; /* ПРИНУДИТЕЛЬНО показываем */
    }

    #seller-filter {
        width: 100%;
        font-size: 1rem;
        padding: 10px 15px;
    }

    /* Основной контент ниже фильтра */
    .work-section {
        margin-top: 20px;
        height: auto;
    }

    .beats-grid {
        max-width: 100%;
    }

    .beat-card {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }

    .beat-info {
        text-align: center;
    }

    .beat-audio {
        width: 100%;
        flex: 0 0 auto; /* фиксируем высоту, чтобы controls не схлопывались */
    }

    .beat-buy {
        width: 100%;
        text-align: center;
    }

    .filter-buttons {
        flex-direction: column;
        gap: 2rem;
        padding: 1rem;
    }

    .producer-switch {
        width: 100%;
        justify-content: center;
        gap: 1.5rem;
    }

    .btn-indicator {
        width: 24px;
        height: 24px;
    }

    .indicator-light {
        width: 16px;
        height: 16px;
    }

    .indicator-glow {
        width: 20px;
        height: 20px;
    }

    .producer-name {
        font-size: 0.9rem;
    }
}

@media screen and (max-width: 768px) {
    body {
        overflow-y: auto;
    }

    .nav-links {
        flex-direction: column;
        align-items: center;
        background: #000; /* полностью непрозрачный фон */
        padding: 10px;
        border-radius: 0; /* убираем скругления, чтобы не было просветов */
        width: 100%; /* во всю ширину экрана */
        gap: 24px;
        z-index: 2000; /* поверх карточек и навигации */
        left: 0;
        transform: none; /* убираем центрирование, чтобы не «скакало» */
    }

    .nav-link {
        width: 100%;
        text-align: center;
        margin: 0;
        font-size: 1.1rem;
        padding: 12px 15px;
        z-index: 201 !important;
        pointer-events: auto !important;
    }

    .nav-link::before {
        z-index: -1 !important;
        pointer-events: none !important;
    }

    .content {
        padding-top: 250px;
    }

    /* Специально для страницы релизов — выше, чтобы VHS-плеер не лез под меню */
    .music-content {
        padding-top: 320px;
    }

    .video-wrapper video {
        width: auto;
        height: 100%;
    }

    .social-links {
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .social-link {
        width: 80%;
        max-width: 300px;
    }

    .artists-grid {
        grid-template-columns: 1fr;
        max-width: 500px;
        margin: 0 auto;
        gap: 3rem;               /* такой же gap, как на ≥769 */
        padding: 120px 5% 100px; /* совпадает с десктопом: 5% боковые, 100px нижний */
        margin-top: 0;
    }

    .artist-card {
        margin-bottom: 20px;
    }

    .artist-image {
        height: 300px;
    }

    /* Кнопки фильтра */
    .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem;
    }

    .producer-switch {
        width: 48%;
        gap: 0.6rem;
        font-size: 0.9rem;
        padding: 0.4rem 0.2rem;
    }

    /* Основной контент – идёт за фильтром */
    .work-section {
        margin-top: 20px;
        position: static;
        height: auto;
        overflow: visible;
        z-index: auto;
    }

    /* Фильтр битов под навигацией */
    .work-filter {
        position: sticky;
        top: 470px; /* под нав-меню */
        left: 0;
        width: 100%;
        max-width: 100%;
        padding: 0.5rem 4% 0.5rem;
        background: rgba(0,0,0,0.95);
        z-index: 1500; /* Выше навигации но ниже nav-links */
        visibility: visible; /* ПРИНУДИТЕЛЬНО показываем */
    }

    .main-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 250px; /* Высота до навигации */
        background: #000;
        z-index: 2000;
    }
}

@media screen and (max-width: 480px) {
    .nav-links {
        width: 100%;
        padding: 8px 10px;
        border-radius: 0;
        background: #000;
        z-index: 2000;
        left: 0;
        transform: none;
    }

    .nav-link {
        font-size: 0.9rem;
        padding: 10px 8px;
        z-index: 201 !important;
    }

    .nav-link::before {
        z-index: -1 !important;
        pointer-events: none !important;
    }

    .glitch-text {
        font-size: 1.5rem;
    }

    .content {
        padding-top: 220px;
    }

    .tv-frame {
        border-width: 10px;
    }
    
    /* Фильтры битов - не даём сжиматься */
    .filter-buttons {
        flex-direction: column;
        gap: 1.2rem;
        padding: 1rem 0.5rem;
        align-items: center;
    }

    .producer-switch {
        width: 100% !important; /* Во всю ширину */
        max-width: 300px; /* Ограничиваем максимальную ширину */
        min-width: 200px; /* Минимальная ширина */
        gap: 1rem;
        font-size: 0.85rem;
        padding: 0.6rem 1rem;
        justify-content: flex-start;
        align-items: center;
    }

    .btn-indicator {
        width: 22px !important;
        height: 22px !important;
        flex-shrink: 0; /* Не даём сжиматься */
    }

    .indicator-light {
        width: 14px !important;
        height: 14px !important;
    }

    .indicator-glow {
        width: 18px !important;
        height: 18px !important;
    }

    .producer-name {
        font-size: 0.85rem;
        white-space: nowrap; /* Не переносим текст */
        overflow: hidden;
        text-overflow: ellipsis;
    }
}

@media screen and (max-width: 380px) {
    .nav-link {
        font-size: 0.8rem;
        padding: 8px 6px;
        z-index: 201 !important;
    }

    .nav-link::before {
        z-index: -1 !important;
        pointer-events: none !important;
    }
    
    .content {
        padding-top: 200px;
    }
    
    /* Фильтры на очень узких экранах */
    .filter-buttons {
        gap: 1rem;
        padding: 0.8rem 0.3rem;
    }

    .producer-switch {
        width: 100% !important;
        max-width: 280px;
        min-width: 180px;
        gap: 0.8rem;
        font-size: 0.8rem;
        padding: 0.5rem 0.8rem;
    }

    .btn-indicator {
        width: 20px !important;
        height: 20px !important;
        flex-shrink: 0;
    }

    .indicator-light {
        width: 12px !important;
        height: 12px !important;
    }

    .indicator-glow {
        width: 16px !important;
        height: 16px !important;
    }

    .producer-name {
        font-size: 0.8rem;
    }
}

/* Стили для страницы релизов */
@media screen and (max-width: 1024px) {
    .music-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        padding: 20px;
    }

    .music-player {
        width: 100%;
        margin: 10px 0;
    }

    .track-info {
        padding: 10px;
    }
}

@media screen and (max-width: 768px) {
    .music-grid {
        grid-template-columns: 1fr;
        max-width: 500px;
        margin: 0 auto;
    }

    .music-player {
        margin-bottom: 20px;
    }

    .controls {
        padding: 10px;
    }
}

/* Стили для страницы контактов */
@media screen and (max-width: 768px) {
    .contacts-section {
        padding: 20px;
        margin-top: 150px;
    }

    .contacts-section h1 {
        font-size: 2rem;
        margin-bottom: 30px;
    }

    .social-links {
        gap: 20px;
    }

    .social-link {
        padding: 15px;
    }
} 

@media screen and (max-width: 1024px) {
  .nav-link::before {
    pointer-events: none !important;
  }
} 

/* --- диапазон 769-1024px: внутр. скролл cooperation --- */
@media screen and (min-width: 769px) and (max-width: 1024px) {
  .work-section {
    margin-top: 140px;                /* ~ нав + фильтр */
    height: calc(100vh - 140px);      /* корректируем высоту */
    overflow-y: auto;
  }
} 

/* === FIX: Seller filter layout & overlap (2025-07-11) === */
@media screen and (min-width: 481px) and (max-width: 770px) {
    /* Располагаем плашки продавцов рядом */
    .filter-buttons {
        flex-direction: row !important; /* переопределяем column */
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    /* Две карточки в ряд (на ~≥480px) */
    .producer-switch {
        flex: 0 0 calc(50% - 1rem) !important;
        width: calc(50% - 1rem) !important;
        margin-top: 0 !important; /* убираем лишний отступ */
    }

    /* Опускаем фильтр строго под навигацию */
    .work-filter {
        top: 260px !important; /* соответствует высоте .main-nav */
    }
}

/* Чуть уже – по одному в строке, но сохраняем строгую границу с навигацией */
@media screen and (max-width: 480px) {
    .work-filter {
        top: 260px !important;
    }
} 

/* === REVISE: Compact seller filter on all sub-770px widths === */
@media screen and (max-width: 770px) {
    .filter-buttons {
        flex-direction: row !important; /* вместо column */
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .producer-switch {
        margin: 0 !important;        /* убираем навязанный margin-top */
        flex: 0 0 calc(50% - 1rem) !important; /* две карточки в ряд */
        width: calc(50% - 1rem) !important;
        padding: 0.6rem 0.3rem !important; /* чуть компактнее */
    }
} 

/* === REVISE 2: 771-1024px layout === */
@media screen and (min-width: 771px) and (max-width: 1024px) {
    .filter-buttons {
        flex-direction: row !important;
        flex-wrap: wrap;            /* переносы разрешены */
        justify-content: center;
        gap: 1.5rem;
        padding: 0.5rem 0;          /* компактнее */
    }
    .producer-switch {
        flex: 0 0 calc(33.333% - 1.5rem) !important; /* три в ряд */
        width: calc(33.333% - 1.5rem) !important;
        margin: 0 !important;
    }
    .work-filter {
        padding-bottom: 1rem !important; /* снижаем высоту */
    }
} 

/* === NAV & FILTER fix: 601-768px === */
@media screen and (min-width: 601px) and (max-width: 768px) {
    .nav-links {
        flex-direction: row !important;
        gap: 30px;
        background: none;
        padding: 15px 0;
    }
    .nav-link {
        width: auto !important;
        font-size: 1rem;
        padding: 10px 12px;
    }
    .main-nav {
        height: 120px !important; /* уменьшенная высота */
    }
    .work-filter {
        top: 140px !important; /* сразу под нав */
    }
    .content {
        padding-top: 160px !important;
    }
} 

/* === Revert: nav fixed for ≤768px === */
@media screen and (max-width: 768px) {
    .main-nav {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
    }
    .nav-links {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
    }
    /* work filter offset handled in JS */
    .work-filter {
        position: fixed;
        left: 0;
        width: 100%;
        top: 470px; /* ниже навигации - чтобы все элементы поместились */
        z-index: 1500;
        height: auto;
        overflow: visible;
        visibility: visible;
        background: rgba(0,0,0,0.95);
        padding: 0.5rem 4% 0.5rem;
    }
    /* Вместо обнуления даём единое смещение, достаточное для всех страниц */
    .content:not(.music-content) {
        padding-top: 260px; /* высота нав + небольшой зазор */
    }

    /* Релизы — плеер: достаточно зазора 260px (высота нав) */
    .content.music-content {
        padding-top: 260px;
    }

    /* Сотрудничество - дополнительное место под фильтр */
    .page-work .content {
        padding-top: 560px; /* навигация + компактный фильтр + минимальный зазор */
    }

    /* Ограничиваем высоту VHS-плеера, чтобы помещался без page-scroll */
    .music-content .vhs-player {
        max-height: calc(100vh - 280px); /* 260px нав + 20px запас */
        overflow: hidden;
    }

    /* --- восстановление фильтра (cooperation) --- */
    .work-filter {
        top: 470px; /* позиционируем ниже навигации */
        padding: 0.5rem 4% 0.5rem;
    }
    .work-filter .filter-buttons {
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
        padding: 0.5rem 0;
    }
    .work-filter .producer-switch {
        flex: none;
        width: 100%;
        margin: 0;
        padding: 0.6rem 1rem;
    }

    /* Обеспечиваем видимость радиобаттонов-индикаторов в мобильной версии */
    .work-filter .btn-indicator {
        position: relative;
        z-index: 1600;
        pointer-events: auto;
        visibility: visible;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .work-filter .indicator-light,
    .work-filter .indicator-glow {
        position: relative;
        z-index: 1601;
        visibility: visible;
        pointer-events: auto;
    }

    /* Чекбоксы остаются скрытыми - они управляют индикаторами */
    .work-filter .filter-checkbox {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        z-index: 1602;
        cursor: pointer;
    }
} 

/* === PAGE-SPECIFIC MOBILE FIXES (2025-07-17) === */
@media screen and (max-width: 768px) {
    /* Релизы */
    .page-music .content {
        padding-top: 260px !important;
    }
    .page-music .vhs-player {
        max-height: calc(100vh - 280px) !important; /* 260px нав + 20px запас */
        overflow: hidden;
    }

    /* Сотрудничество – позиционирование управляет JS, CSS тут не задаёт top/padding */
} 

@media (max-width: 950px) and (min-width: 769px) {
  .page-work .work-filter {
    visibility: visible;
    height: auto;
    min-height: unset;
    overflow: visible;
  }
  .page-work .filter-buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    height: auto;
    overflow: visible;
    background: none;
    margin: 0;
    padding: 0;
  }
  .page-work .producer-switch {
    min-width: 120px;
    max-width: 220px;
    width: auto;
    flex: 0 1 auto;
    margin: 0.3rem 0.3rem 0 0;
    padding: 0.3rem 0.5rem;
    font-size: 0.95rem;
    background: none;
    color: #fff;
    border: none;
    box-sizing: border-box;
  }
} 

/* --- Фикс: адаптивные стили для фильтра --- */
@media screen and (min-width: 769px) {
  .filter-buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    margin: 0;
    padding: 0;
    background: none;
  }
  .producer-switch {
    min-width: 120px;
    max-width: 220px;
    width: auto;
    flex: 0 1 auto;
    margin: 0.3rem 0.3rem 0 0;
    padding: 0.3rem 0.5rem;
    font-size: 0.95rem;
    background: none;
    color: #fff;
    border: none;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }
}

/* Мобильные стили - вертикальная раскладка */
@media screen and (max-width: 768px) {
  .filter-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    padding: 0.5rem 0;
    background: none;
    visibility: visible;
    overflow: visible;
  }
  .producer-switch {
    width: 100%;
    margin: 0;
    padding: 0.6rem 1rem;
    font-size: 1rem;
    background: none;
    color: #fff;
    border: none;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    visibility: visible;
    position: relative;
    z-index: 1600;
  }
} 